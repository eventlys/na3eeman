  "appRulesTitle": "App Rules & Policies",
  "@appRulesTitle": { "description": "App rules popup title" },
  "userGuideTitle": "User Guide",
  "@userGuideTitle": { "description": "User guide popup title" },
  "rulesForYourRole": "Rules for your role",
  "@rulesForYourRole": { "description": "Role-specific rules subtitle" },

  "rulesCustomer": "1. Book appointments only during salon operating hours.\n2. Cancel at least 2 hours before your appointment to avoid a no-show flag.\n3. Respect stylists and staff — harassment results in account suspension.\n4. Reviews must be honest and based on your personal experience.\n5. Do not share your account credentials with others.\n6. Loyalty points are non-transferable and expire after 12 months of inactivity.",
  "@rulesCustomer": { "description": "Rules for customers" },

  "rulesEmployee": "1. Arrive at least 15 minutes before your first appointment.\n2. Mark yourself unavailable in the app if you cannot serve clients that day.\n3. All appointment updates must be done through the app — not phone calls.\n4. Keep your tools & inventory updated after every service.\n5. Earnings and commissions are calculated automatically; disputes go through your owner.\n6. Do not accept cash outside the app payment flow.",
  "@rulesEmployee": { "description": "Rules for employees/barbers" },

  "rulesOwner": "1. Keep your salon profile, services and prices up to date.\n2. Respond to disputes within 48 hours or the system will auto-resolve in the customer's favour.\n3. Data exports are for business use only — do not share exported files.\n4. Staff accounts you create are your responsibility.\n5. Subscriptions auto-renew; cancel at least 7 days before renewal to avoid charges.\n6. Marketing campaigns must comply with Jordanian advertising regulations.",
  "@rulesOwner": { "description": "Rules for salon owners" },

  "rulesReceptionist": "1. You may create, reschedule or cancel appointments on behalf of customers.\n2. Never access financial reports — that is an owner-only function.\n3. Data exports you initiate are logged and visible to the salon owner.\n4. Do not modify staff commissions or payroll settings.\n5. Report any system issues to the salon owner immediately.\n6. Customer data accessed must remain strictly confidential.",
  "@rulesReceptionist": { "description": "Rules for receptionists" },

  "rulesIntern": "1. Attend all scheduled shifts and training sessions.\n2. Complete your daily tasks before the end of your shift.\n3. You may shadow senior staff but must not perform services unsupervised.\n4. Report progress and any difficulties to your assigned mentor.\n5. Do not access customer financial data or payment records.\n6. Treat all customer information with the utmost confidentiality.",
  "@rulesIntern": { "description": "Rules for interns" },

  "rulesCofounder": "1. Co-Founders have identical access rights to the primary Owner.\n2. All Owner rules apply — data exports are for business use only.\n3. Disputes between Co-Founders and Owners are handled outside the app.\n4. Co-Founder accounts can be revoked by the primary Owner at any time.\n5. Financial decisions (subscription changes, payroll) should be coordinated with the Owner.\n6. Co-Founders are equally responsible for salon compliance and staff conduct.",
  "@rulesCofounder": { "description": "Rules for co-founders" },

  "guideCustomer": "Getting started:\n• Find salons by category or location on the Home screen.\n• Tap a salon to view services, staff, and available time slots.\n• Select a service, choose a staff member (optional), then pick a date & time.\n• Pay cash at the salon or via the in-app payment flow.\n• Earn loyalty points with every completed appointment — redeem for free services.\n• Rate your experience after every visit to help others.",
  "@guideCustomer": { "description": "User guide for customers" },

  "guideEmployee": "Getting started:\n• Your dashboard shows today's appointments and your daily schedule.\n• Tap an appointment to see customer details and service requirements.\n• Mark appointments as In-Progress or Completed when done.\n• Update your tools & inventory after each service.\n• Check your earnings and commission breakdown in the Stats section.\n• Contact your salon owner for payroll or schedule changes.",
  "@guideEmployee": { "description": "User guide for employees" },

  "guideOwner": "Getting started:\n• Set up your salon profile: name, photos, location and opening hours.\n• Add your services with prices and durations.\n• Invite staff by creating employee accounts from the Staff section.\n• Activate your subscription plan to unlock all features.\n• Monitor revenue, appointments and staff performance from the Dashboard.\n• Create offers and campaigns from the Marketing section.\n• Export your data from the Data Management page at any time.",
  "@guideOwner": { "description": "User guide for owners" },

  "guideReceptionist": "Getting started:\n• Use the Receptionist Desk to view and manage all today's appointments.\n• Create walk-in appointments for customers directly from the calendar.\n• Search for customers by name or phone to pull up their booking history.\n• Process payments and mark appointments as complete.\n• Use the Data Management page to export appointment or customer reports.\n• Escalate any issues to the salon owner.",
  "@guideReceptionist": { "description": "User guide for receptionists" },

  "guideIntern": "Getting started:\n• Check your Daily Tasks section every morning before your shift.\n• Shadow your assigned mentor and take notes in the Activity section.\n• Mark tasks as complete when done — your owner tracks your progress.\n• Ask your mentor before attempting any customer service independently.\n• Your schedule is set by the salon owner — check it the night before.\n• Complete your monthly training targets to unlock higher responsibilities.",
  "@guideIntern": { "description": "User guide for interns" },

  "guideCofounder": "Getting started:\n• You have access to everything the Owner can do — use it responsibly.\n• The Dashboard shows real-time revenue, appointments and staff activity.\n• Use the Data Management page to export or restore salon data.\n• Coordinate with the primary Owner before making subscription or billing changes.\n• Staff management: you can create, edit or deactivate staff accounts.\n• Marketing: launch campaigns and offers from the Marketing section.",
  "@guideCofounder": { "description": "User guide for co-founders" },

